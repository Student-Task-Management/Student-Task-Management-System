# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_USER=studyflow
MONGO_PASSWORD=change-me-use-letters-and-numbers-only
MONGO_DB=studyflow
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# The public address of the site (use https://yourdomain.site on the server)
CLIENT_URL=http://localhost:8080
# The port Nginx listens on, on this machine only
WEB_PORT=8080
